# house-audio-server runtime configuration
# Keep deployment-specific/private addresses out of Git.

HOUSE_AUDIO_BIND=0.0.0.0
HOUSE_AUDIO_PORT=8787

MPD_HOST=127.0.0.1
MPD_PORT=6600
MPD_TIMEOUT=2.0

# Snapserver JSON-RPC control socket
SNAPSERVER_HOST=127.0.0.1
SNAPSERVER_CONTROL_PORT=1705
SNAPSERVER_CONNECT_TIMEOUT=2.0
SNAPSERVER_RETRY_SECONDS=2.0
