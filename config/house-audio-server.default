# house-audio-server runtime configuration
# Keep deployment-specific/private addresses out of Git.

HOUSE_AUDIO_BIND=0.0.0.0
HOUSE_AUDIO_PORT=8787

MPD_HOST=127.0.0.1
MPD_PORT=6600
MPD_TIMEOUT=2.0

# Snapserver JSON-RPC control socket
SNAPSERVER_HOST=127.0.0.1
SNAPSERVER_CONTROL_PORT=1705
SNAPSERVER_CONNECT_TIMEOUT=2.0
SNAPSERVER_RETRY_SECONDS=2.0

# Effective renderer presence: poll lastSeen and age out abrupt power loss
SNAPSERVER_POLL_SECONDS=1.0
SNAPSERVER_STALE_AFTER_SECONDS=5.0

# First autonomous session-policy slice:
# when the final passive renderer leaves during playback, finish the current
# track and stop; cancel that pending stop if a renderer returns first.
PASSIVE_SESSION_POLICY_ENABLED=true
PASSIVE_SESSION_POLICY_POLL_SECONDS=0.5

# Folder loaded automatically when the first passive renderer appears in fresh idle.
# Each fresh session gets a new shuffle; a completed old queue is not resumed.
PASSIVE_DEFAULT_FOLDER=MP3s

# Lightweight in-memory renderer diagnostics. Records only state changes and
# stalls, not every sample.
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_POLL_SECONDS=1.0
DIAGNOSTICS_STALL_WARN_SECONDS=2.5
DIAGNOSTICS_HISTORY_LIMIT=200
