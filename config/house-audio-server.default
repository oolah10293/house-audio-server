# house-audio-server runtime configuration
# Keep deployment-specific/private addresses out of Git.

HOUSE_AUDIO_BIND=0.0.0.0
HOUSE_AUDIO_PORT=8787

MPD_HOST=127.0.0.1
MPD_PORT=6600
MPD_TIMEOUT=2.0

# Snapserver JSON-RPC control socket
SNAPSERVER_HOST=127.0.0.1
SNAPSERVER_CONTROL_PORT=1705
SNAPSERVER_CONNECT_TIMEOUT=2.0
SNAPSERVER_RETRY_SECONDS=2.0

# Effective renderer presence: poll lastSeen and age out abrupt power loss
SNAPSERVER_POLL_SECONDS=1.0
SNAPSERVER_STALE_AFTER_SECONDS=5.0

# Automatic controller/renderer session policy (including final-track drain).
# The service-start fresh-idle reset still runs when this is false; only
# presence-driven playback is disabled. Saved settings/ownership persist.
PASSIVE_SESSION_POLICY_ENABLED=true
PASSIVE_SESSION_POLICY_POLL_SECONDS=0.5

# Install-time fallback when no saved passive default exists: MP3s or Rap.
# GET/POST /settings reads/changes the persisted choice without touching playback.
# Each fresh session gets a new shuffle; a completed old queue is not resumed.
PASSIVE_DEFAULT_FOLDER=MP3s
HOUSE_AUDIO_SETTINGS_FILE=/var/lib/house-audio-server/settings.json

# Background controllers retain presence while heartbeats are fresh. Quit
# detaches immediately; a lost control connection expires after 15 seconds.
CONTROLLER_HEARTBEAT_SECONDS=5
CONTROLLER_LEASE_SECONDS=15
# Only renderer ownership is saved, not live leases or playback state.
HOUSE_AUDIO_CONTROLLERS_FILE=/var/lib/house-audio-server/controllers.json

# Shared radio bookmarks persist; playback/retry state does not survive restart.
HOUSE_AUDIO_RADIO_STATIONS_FILE=/var/lib/house-audio-server/radio-stations.json

# Descriptive radio song history only; never resumes playback after restart.
HOUSE_AUDIO_RADIO_HISTORY_FILE=/var/lib/house-audio-server/radio-history.json
